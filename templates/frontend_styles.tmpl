:root {
  color-scheme: dark;
  --bg: #1b1e27;
  --fg: #e6e9ef;
  --muted: #8b93a7;
  --accent: #27c93f;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  display: grid;
  place-items: center;
  background: var(--bg);
  color: var(--fg);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

main {
  max-width: 640px;
  padding: 40px;
  text-align: center;
}

h1 { font-size: 2rem; margin-bottom: 8px; }

p { color: var(--muted); }

code {
  background: #2b2f3a;
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 0.9em;
}

button {
  margin-top: 24px;
  padding: 10px 18px;
  border: none;
  border-radius: 8px;
  background: var(--accent);
  color: #08210d;
  font-weight: 600;
  font-size: 0.95rem;
  cursor: pointer;
}

button:hover { filter: brightness(1.08); }

.out {
  margin-top: 16px;
  min-height: 1.5rem;
  color: var(--accent);
}
