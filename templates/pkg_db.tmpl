package db

import (
	"database/sql"

	_ "github.com/lib/pq"
)

// New opens a Postgres connection pool and verifies it with a ping.
func New(dsn string) (*sql.DB, error) {
	conn, err := sql.Open("postgres", dsn)
	if err != nil {
		return nil, err
	}
	if err := conn.Ping(); err != nil {
		return nil, err
	}
	return conn, nil
}
