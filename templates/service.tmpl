package {{.Package}}

import (
	"context"

	ent "{{.Imports.Entity}}"
	repo "{{.Imports.Repository}}"
)

{{- $repoType := printf "*repo.%sRepository" (.Entity | ToPascalCase)}}
{{- if .RepoIsInterface}}{{$repoType = printf "repo.%sRepository" (.Entity | ToPascalCase)}}{{end}}

// {{.Entity | ToPascalCase}}Service holds the {{.Entity | ToLower}} use cases.
type {{.Entity | ToPascalCase}}Service struct {
	repo {{$repoType}}
}

// New{{.Entity | ToPascalCase}}Service builds a {{.Entity | ToLower}} service over the given repository.
func New{{.Entity | ToPascalCase}}Service(r {{$repoType}}) *{{.Entity | ToPascalCase}}Service {
	return &{{.Entity | ToPascalCase}}Service{repo: r}
}

func (s *{{.Entity | ToPascalCase}}Service) Create(ctx context.Context, m *ent.{{.Entity | ToPascalCase}}) error {
	return s.repo.Create(ctx, m)
}

func (s *{{.Entity | ToPascalCase}}Service) Get(ctx context.Context, id int64) (*ent.{{.Entity | ToPascalCase}}, error) {
	return s.repo.GetByID(ctx, id)
}

func (s *{{.Entity | ToPascalCase}}Service) List(ctx context.Context) ([]*ent.{{.Entity | ToPascalCase}}, error) {
	return s.repo.List(ctx)
}

func (s *{{.Entity | ToPascalCase}}Service) Update(ctx context.Context, m *ent.{{.Entity | ToPascalCase}}) error {
	return s.repo.Update(ctx, m)
}

func (s *{{.Entity | ToPascalCase}}Service) Delete(ctx context.Context, id int64) error {
	return s.repo.Delete(ctx, id)
}
