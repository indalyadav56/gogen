package main

import (
	"context"
	"errors"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"go.uber.org/zap"

	"{{.Module}}/internal/config"
	"{{.Module}}/internal/di"
	srvhttp "{{.Module}}/internal/server/http"
	"{{.Module}}/pkg/logger"
)

func main() {
	cfg, err := config.Load()
	if err != nil {
		panic(err)
	}

	lg := logger.Init(cfg.Log.Level, cfg.Log.File)
	defer func() { _ = lg.Sync() }()

	container, err := di.New(cfg, lg)
	if err != nil {
		lg.Fatal("failed to build container", zap.Error(err))
	}
	defer container.Close()

	srv := &http.Server{
		Addr:    ":" + cfg.Server.Port,
		Handler: srvhttp.NewRouter(container),
	}

	go func() {
		lg.Info("server starting", zap.String("port", cfg.Server.Port))
		if err := srv.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
			lg.Fatal("server failed", zap.Error(err))
		}
	}()

	// Graceful shutdown on SIGINT/SIGTERM.
	quit := make(chan os.Signal, 1)
	signal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)
	<-quit
	lg.Info("shutting down")

	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	if err := srv.Shutdown(ctx); err != nil {
		lg.Error("graceful shutdown failed", zap.Error(err))
	}
}
