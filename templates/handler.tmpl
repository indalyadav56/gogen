package {{.Package}}

{{- $P := .Entity | ToPascalCase}}
{{- $route := .Entity | ToLower | Plural}}
{{- if eq .Router "gin"}}
import (
	"net/http"

	"github.com/gin-gonic/gin"

	svc "{{.Imports.Service}}"
	"{{.Module}}/pkg/logger"
)

// {{$P}}Handler exposes {{.Entity | ToLower}} HTTP endpoints.
type {{$P}}Handler struct {
	service *svc.{{$P}}Service
}

// New{{$P}}Handler wires a {{.Entity | ToLower}} handler to its service.
func New{{$P}}Handler(service *svc.{{$P}}Service) *{{$P}}Handler {
	return &{{$P}}Handler{service: service}
}
{{- if .EmbedRoutes}}

// RegisterRoutes mounts the {{.Entity | ToLower}} routes onto the given group.
func (h *{{$P}}Handler) RegisterRoutes(rg *gin.RouterGroup) {
	g := rg.Group("/{{$route}}")
	g.GET("", h.List)
	g.POST("", h.Create)
	g.GET("/:id", h.Get)
	g.PUT("/:id", h.Update)
	g.DELETE("/:id", h.Delete)
}
{{- end}}

