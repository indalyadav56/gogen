}
{{- if .EmbedRoutes}}

// RegisterRoutes mounts the {{.Entity | ToLower}} routes onto the given router.
func (h *{{$P}}Handler) RegisterRoutes(r chi.Router) {
	r.Route("/{{$route}}", func(r chi.Router) {
		r.Get("/", h.List)
		r.Post("/", h.Create)
		r.Get("/{id}", h.Get)
		r.Put("/{id}", h.Update)
		r.Delete("/{id}", h.Delete)
	})
}
