# {{.Project}} configuration.
# Any value can be overridden by an environment variable:
#   server.port  -> SERVER_PORT
#   database.url -> DATABASE_URL
#   log.level    -> LOG_LEVEL
#   log.file     -> LOG_FILE
server:
  port: "8080"
{{- if ne .Arch "simple"}}

database:
  url: "postgres://postgres:postgres@localhost:5432/{{.Project}}?sslmode=disable"

log:
  level: "info"          # debug | info | warn | error
  file: "logs/app.log"   # rotated by lumberjack
{{- end}}
{{- if .Auth}}

auth:
  secret: "change-me-in-production"   # override via AUTH_SECRET
  access_ttl: "15m"
  refresh_ttl: "168h"                 # 7 days
{{- end}}
