package {{.Package}}

{{- if eq .Router "gin"}}
import (
	"github.com/gin-gonic/gin"

	hdl "{{.Imports.Handler}}"
	mw "{{.Imports.Middleware}}"
)

// RegisterAuthRoutes mounts the /auth endpoints. register/login/refresh are
// public; /me requires authentication; /admin additionally requires the
// "users:read" permission (an RBAC example).
func RegisterAuthRoutes(rg *gin.RouterGroup, h *hdl.AuthHandler, m *mw.Middleware) {
	g := rg.Group("/auth")
	g.POST("/register", h.Register)
	g.POST("/login", h.Login)
	g.POST("/refresh", h.Refresh)

	authed := g.Group("")
	authed.Use(m.RequireAuth())
	authed.GET("/me", h.Me)

	admin := g.Group("")
	admin.Use(m.RequireAuth(), m.RequirePermission("users:read"))
	admin.GET("/admin", h.Me)
}
{{- else}}
import (
	"github.com/go-chi/chi/v5"

	hdl "{{.Imports.Handler}}"
	mw "{{.Imports.Middleware}}"
)

// RegisterAuthRoutes mounts the /auth endpoints. register/login/refresh are
// public; /me requires authentication; /admin additionally requires the
// "users:read" permission (an RBAC example).
func RegisterAuthRoutes(r chi.Router, h *hdl.AuthHandler, m *mw.Middleware) {
	r.Route("/auth", func(r chi.Router) {
		r.Post("/register", h.Register)
		r.Post("/login", h.Login)
		r.Post("/refresh", h.Refresh)

		r.Group(func(r chi.Router) {
			r.Use(m.RequireAuth)
			r.Get("/me", h.Me)
		})
		r.Group(func(r chi.Router) {
			r.Use(m.RequireAuth, m.RequirePermission("users:read"))
			r.Get("/admin", h.Me)
		})
	})
}
{{- end}}
