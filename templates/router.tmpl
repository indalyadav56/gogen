// Package http builds the application's HTTP router from the DI container.
package http

{{- if eq .Router "gin"}}
import (
	"github.com/gin-gonic/gin"

	"{{.Module}}/internal/di"
	mw "{{.Module}}/internal/server/http/middleware"
	"{{.Module}}/internal/transport/http/v1/routes"
{{- if eq .Arch "microservice"}}
	"{{.Module}}/internal/health"
{{- end}}
{{- if .Auth}}
	authrt "{{.Module}}/internal/auth/transport/http/v1/routes"
{{- end}}
{{- if ne .Frontend "none"}}
	frontend "{{.Module}}/web"
{{- end}}
)

// NewRouter assembles middleware and routes around the container's handlers.
func NewRouter(c *di.Container) *gin.Engine {
	r := gin.New()
	r.Use(mw.Recovery(c.Logger), mw.RequestID(), mw.Logger(c.Logger))
{{- if eq .Arch "microservice"}}
	r.GET("/healthz", health.Handler)
{{- end}}

	v1 := r.Group("/api/v1")
{{- range .Entities}}
	routes.Register{{. | ToPascalCase}}Routes(v1, c.{{. | ToPascalCase}}Handler)
{{- end}}
{{- if .Auth}}
	authrt.RegisterAuthRoutes(v1, c.AuthHandler, c.AuthMiddleware)
{{- end}}
{{- if ne .Frontend "none"}}
	r.NoRoute(gin.WrapH(frontend.Handler()))
{{- end}}
	return r
}
{{- else}}
import (
	"github.com/go-chi/chi/v5"

	"{{.Module}}/internal/di"
	mw "{{.Module}}/internal/server/http/middleware"
	"{{.Module}}/internal/transport/http/v1/routes"
{{- if eq .Arch "microservice"}}
	"{{.Module}}/internal/health"
{{- end}}
{{- if .Auth}}
	authrt "{{.Module}}/internal/auth/transport/http/v1/routes"
{{- end}}
{{- if ne .Frontend "none"}}
	frontend "{{.Module}}/web"
{{- end}}
)

// NewRouter assembles middleware and routes around the container's handlers.
func NewRouter(c *di.Container) chi.Router {
	r := chi.NewRouter()
	r.Use(mw.RequestID, mw.Logger(c.Logger), mw.Recovery(c.Logger))
{{- if eq .Arch "microservice"}}
	r.Get("/healthz", health.Handler)
{{- end}}

	r.Route("/api/v1", func(r chi.Router) {
{{- range .Entities}}
		routes.Register{{. | ToPascalCase}}Routes(r, c.{{. | ToPascalCase}}Handler)
{{- end}}
{{- if .Auth}}
		authrt.RegisterAuthRoutes(r, c.AuthHandler, c.AuthMiddleware)
{{- end}}
	})
{{- if ne .Frontend "none"}}
	r.Handle("/*", frontend.Handler())
{{- end}}
	return r
}
{{- end}}
