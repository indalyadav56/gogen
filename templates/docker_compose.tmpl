services:
  app:
    build: .
    ports:
      - "8080:8080"
      - "9090:9090"
    environment:
      - PORT=8080
      - DATABASE_URL=postgres://postgres:postgres@db:5432/{{.Project}}?sslmode=disable
    depends_on:
      - db

  db:
    image: postgres:16-alpine
    environment:
      - POSTGRES_USER=postgres
      - POSTGRES_PASSWORD=postgres
      - POSTGRES_DB={{.Project}}
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data

volumes:
  pgdata:
