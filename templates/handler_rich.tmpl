package {{.Package}}

{{- $P := .Entity | ToPascalCase}}
{{- if eq .Router "gin"}}
import (
	"net/http"

	"github.com/gin-gonic/gin"

	dto "{{.Imports.DTO}}"
	svc "{{.Imports.Service}}"
	"{{.Module}}/pkg/response"
	"{{.Module}}/pkg/validator"
)

// {{$P}}Handler exposes {{.Entity | ToLower}} HTTP endpoints.
type {{$P}}Handler struct {
	service *svc.{{$P}}Service
}

// New{{$P}}Handler wires a {{.Entity | ToLower}} handler to its service.
func New{{$P}}Handler(service *svc.{{$P}}Service) *{{$P}}Handler {
	return &{{$P}}Handler{service: service}
}

func (h *{{$P}}Handler) List(c *gin.Context) {
	response.Error(c.Writer, http.StatusNotImplemented, "not implemented")
}

func (h *{{$P}}Handler) Create(c *gin.Context) {
	var req dto.Create{{$P}}Request
	if err := c.ShouldBindJSON(&req); err != nil {
		response.Error(c.Writer, http.StatusBadRequest, err.Error())
		return
	}
	if err := validator.Validate(&req); err != nil {
		response.Error(c.Writer, http.StatusBadRequest, err.Error())
		return
	}
	response.Error(c.Writer, http.StatusNotImplemented, "not implemented")
}

func (h *{{$P}}Handler) Get(c *gin.Context) {
	response.Error(c.Writer, http.StatusNotImplemented, "not implemented")
}

func (h *{{$P}}Handler) Update(c *gin.Context) {
	response.Error(c.Writer, http.StatusNotImplemented, "not implemented")
}

func (h *{{$P}}Handler) Delete(c *gin.Context) {
	response.Error(c.Writer, http.StatusNotImplemented, "not implemented")
}
{{- else}}
import (
	"encoding/json"
	"net/http"

	dto "{{.Imports.DTO}}"
	svc "{{.Imports.Service}}"
	"{{.Module}}/pkg/response"
	"{{.Module}}/pkg/validator"
)

// {{$P}}Handler exposes {{.Entity | ToLower}} HTTP endpoints.
type {{$P}}Handler struct {
	service *svc.{{$P}}Service
}

// New{{$P}}Handler wires a {{.Entity | ToLower}} handler to its service.
func New{{$P}}Handler(service *svc.{{$P}}Service) *{{$P}}Handler {
	return &{{$P}}Handler{service: service}
}

func (h *{{$P}}Handler) List(w http.ResponseWriter, r *http.Request) {
	response.Error(w, http.StatusNotImplemented, "not implemented")
}

func (h *{{$P}}Handler) Create(w http.ResponseWriter, r *http.Request) {
	var req dto.Create{{$P}}Request
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		response.Error(w, http.StatusBadRequest, err.Error())
		return
	}
	if err := validator.Validate(&req); err != nil {
		response.Error(w, http.StatusBadRequest, err.Error())
		return
	}
	response.Error(w, http.StatusNotImplemented, "not implemented")
}

func (h *{{$P}}Handler) Get(w http.ResponseWriter, r *http.Request) {
	response.Error(w, http.StatusNotImplemented, "not implemented")
}

func (h *{{$P}}Handler) Update(w http.ResponseWriter, r *http.Request) {
	response.Error(w, http.StatusNotImplemented, "not implemented")
}

func (h *{{$P}}Handler) Delete(w http.ResponseWriter, r *http.Request) {
	response.Error(w, http.StatusNotImplemented, "not implemented")
}
{{- end}}
