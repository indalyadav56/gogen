# syntax=docker/dockerfile:1
{{- if eq .Frontend "react"}}

# Build the React frontend so the Go binary can embed web/dist.
FROM node:20-alpine AS frontend
WORKDIR /app/web
COPY web/package*.json ./
RUN npm install
COPY web/ ./
RUN npm run build
{{- end}}

FROM golang:1.24-alpine AS build
WORKDIR /app
COPY go.* ./
RUN go mod download
COPY . .
{{- if eq .Frontend "react"}}
COPY --from=frontend /app/web/dist ./web/dist
{{- end}}
RUN CGO_ENABLED=0 go build -o /app/server ./{{if eq .Arch "simple"}}.{{else}}cmd/server{{end}}

FROM alpine:3.20
RUN adduser -D -u 10001 app
USER app
COPY --from=build /app/server /server
EXPOSE 8080
ENTRYPOINT ["/server"]
